# ClinForms (src/modules/medreport) + Simulated TM3 sandbox (src/sandbox/tm3-sim)
# Copy to .env.local (gitignored) and fill in. Never commit real values. All are server-side only:
# none of these may be prefixed NEXT_PUBLIC_ and none is ever sent to the browser.

# Anthropic API key for live drafting and live form analysis. Use a spend-limited workspace.
# Without it the Studio runs in demo mode (pre-written / recorded drafts, clearly badged).
ANTHROPIC_API_KEY=

# Optional: the Claude model for live drafting and form analysis. Default (empty): claude-sonnet-5-5.
# Allowed: claude-sonnet-5-5, claude-opus-5-5, claude-opus-5, claude-sonnet-5, claude-haiku-5-5,
# claude-opus-4-8 (the allow-list in src/modules/medreport/config.server.ts). Anything else is ignored
# with a warning in the server log, and the default is used. The effort levels (DEFAULT_LIVE_EFFORT,
# DEFAULT_ANALYSIS_EFFORT) were measured on claude-sonnet-5-5; re-run the effort sweep before
# switching models. The model id is never shown to the clinic.
MEDREPORT_MODEL=

# auto (default) | demo | live
# auto/live: live drafting when ANTHROPIC_API_KEY and MEDREPORT_LIVE_PASSCODE are both set; otherwise demo.
# demo: never call the AI. In demo mode the secrets below fall back to fixed, public demo constants
# (except the launch and signing secrets on a production deployment – see below).
MEDREPORT_AI_MODE=

# Passcode the presenter types in the Studio to allow live AI calls (sent as x-medreport-passcode,
# compared in constant time, ~6 live calls/min per instance). Wrong guesses are limited: 5 per client
# and 30 per instance in 10 minutes, then 429 with Retry-After. Use 16+ random characters (a short
# passcode can still be guessed slowly across instances) and rotate it after each demo.
MEDREPORT_LIVE_PASSCODE=

# HMAC secret for launch tokens (10 min, single use) and session tokens (1 h). Required outside demo mode.
# Production deployments (VERCEL_ENV=production): set it, even in demo mode. If it is unset there, it is
# derived from ANTHROPIC_API_KEY or VERCEL_AUTOMATION_BYPASS_SECRET; with neither, requests fail –
# the public demo constant is never used in production unless MEDREPORT_ALLOW_DEMO_SECRETS=1.
MEDREPORT_LAUNCH_SECRET=

# HMAC secret for approval receipts (SignReceipt.mac), form-map confirmations and filed-document
# tokens (purpose-bound keys are derived from it). Same production rule as MEDREPORT_LAUNCH_SECRET.
MEDREPORT_SIGNING_SECRET=

# Optional, NOT recommended: set to 1 to let a production deployment use the public demo constants for
# the two secrets above (anyone who reads the repository could then forge approvals). Previews and
# local runs do not need it.
MEDREPORT_ALLOW_DEMO_SECRETS=

# Partner key the clinic system (here: the simulated TM3 sandbox's server) sends as x-partner-key
# on POST /api/reports/v1/launch. Required outside demo mode.
MEDREPORT_PARTNER_KEY=

# Bearer token the connector sends to the simulated TM3 API (/api/tm3-sim/v1). Required outside demo mode.
TM3_SIM_TOKEN=

# Optional absolute base URL of the simulated TM3 API host, e.g. https://clinforms.co.uk
# Default: this server's own origin – the Vercel deployment's VERCEL_URL, else http://127.0.0.1:$PORT –
# never the request's Host header. Falls back to in-process calls if HTTP is blocked.
TM3_SIM_BASE_URL=

# Optional path to LibreOffice (soffice) for the PDF copy of a completed Word form. Default: the usual
# install paths (/usr/bin/soffice …). Not available on Vercel: there /render?format=pdf for a Word form
# answers 503 PDF_CONVERSION_UNAVAILABLE ("download Word"). The converter runs with macros and links
# disabled, a minimal environment, at most 2 at a time and a process-group kill on timeout; on a real
# deployment keep LibreOffice patched and run it on a host without outbound network access.
MEDREPORT_SOFFICE_PATH=

# DEV / DEMO ONLY – never on a deployment. Folder of local demonstration forms (third-party forms such
# as public insurer PDFs, which are never committed: /demo-assets/ is gitignored), absolute or relative
# to the working directory, e.g. demo-assets/insurers. It holds the forms (*.pdf / *.docx), maps/<id>.json
# (prepared form maps) and drafts/<patientId>__form-<id>.json (prepared answers for a simulated TM3 demo
# patient). An upload of such a form in demo mode then gets its prepared map and answers without any
# live call, and every preview and final file of it carries the footer "Public form used for
# demonstration only – not affiliated with or endorsed by <insurer>. Fictional patient data."
# Check the folder with `npm run demo:check`. Ignored on a production build or deployment (NODE_ENV or
# VERCEL_ENV "production") unless MEDREPORT_DEMO_ASSETS_ALLOW_PROD=1. A relative path is read from the
# working directory: in a git worktree (no demo-assets/ of its own) give the absolute path of the folder.
MEDREPORT_DEMO_ASSETS_DIR=

# DEV / DEMO ONLY: 1 lets a LOCAL production build (`next build && next start` on this machine – what
# `npm run demo:red` runs, and it sets this itself) use MEDREPORT_DEMO_ASSETS_DIR. Never set it on a
# deployment: third-party insurer material must never be served from production.
MEDREPORT_DEMO_ASSETS_ALLOW_PROD=
