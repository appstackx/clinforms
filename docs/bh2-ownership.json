    "WD": { "title": "Drafting, assembly and text edits", "branches": ["ws/bh2-drafting"], "aliases": ["wd", "drafting"] },
    "WE": { "title": "Data, maps and mapping page", "branches": ["ws/bh2-data"], "aliases": ["we", "data"] },
    "WF": { "title": "Copy, preview and guide", "branches": ["ws/bh2-copy"], "aliases": ["wf", "copy"] }
  },
  "fixBranches": {
