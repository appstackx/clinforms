  "base": {
    "tag": "bh2-base",
    "fallback": "origin/release/bh-trial-2",
    "note": "Workstream branches start at tag bh2-base; until it exists the guard diffs against the merge base with origin/release/bh-trial-2."
  },
  "workstreams": {
    "W0": { "title": "Foundation: base, safety corpus and gates, schema expansion, module split, tokenizer, shared types", "branches": ["ws/bh2-foundation", "ws/bh2-split", "ws/bh2-schema", "ws/bh2-corpus", "ws/bh2-tokenizer"], "exempt": true },
    "WI": { "title": "Integration", "branches": ["release/bh-trial-2"], "exempt": true },
